#!/bin/sh
# Block session links from leaving the machine. RH's standing rule: Claude
# conversation/session links must never appear in anything public.
#
# WHY A HOOK AND NOT A HABIT. On 2026-07-27 a by-hand pre-push check passed
# while 297 such trailers sat in already-public history -- it scoped to the
# unpushed range and returned a clean zero. The rule is about what is PUBLIC,
# not what is new. A check that must be remembered, whose scope must be chosen
# correctly each time, is not a check.
#
# SCOPE IS THE COMMITS BEING PUSHED, deliberately. RH ruled on 2026-07-27 that
# the existing 297 stay (a rewrite does not unpublish: GitHub serves
# unreachable objects by SHA, and forks and clones keep them regardless), so a
# full-history check would block every push forever and be disabled within a
# day. This hook exists so the set never GROWS.
#
# Refs arrive on STDIN as "<local ref> <local sha> <remote ref> <remote sha>".
# The first version of this hook read $1 and $2 -- which are the remote NAME
# and URL -- so its rev-list failed and it fell back to scanning all history,
# blocking the very push it was written to permit. It failed closed, which is
# the right direction to fail, but it was still wrong.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"                          # new branch: all its commits
    else
        range="$remote_sha..$local_sha"
    fi
    hits=$(git log --format='%H%n%s%n%b' "$range" 2>/dev/null \
           | grep -icE 'claude\.ai/code/session|Claude-Session:')
    if [ "${hits:-0}" -gt 0 ]; then
        echo "PUSH BLOCKED: $hits session-link reference(s) in commits being pushed."
        echo "Strip the Claude-Session trailers before pushing."
        status=1
    fi
done
exit $status
