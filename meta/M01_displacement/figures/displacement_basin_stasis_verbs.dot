// stasis basin watershed — sinks (computed: purity>=0.9,
// in>=5) + top-6 feeders each + top-2 second-hop feeders.
// All edges displacement-coupled and split-half certified.
digraph basin {
  rankdir=LR; node [shape=box, style="rounded,filled",
    fillcolor=white, fontname="Helvetica", fontsize=12];
  edge [fontsize=8, color="#777777", fontcolor="#555555"];
  labelloc="b"; labeljust="l"; fontname="Helvetica"; fontsize=9;
  fontcolor="#555555";
  label="STASIS basin — population: VERBS ONLY (795 coupled pairs, 419 words).\lSinks (bordered) are COMPUTED: purity >= 0.9, in-degree >= 5.\lTheir grouping into a 'stasis' basin is a READING, an editorial layer, not a computed property.\lEdges are displacement-coupled and split-half certified; labels are shrunken full-data lift.\lLifts are NOT comparable across populations: the verb restriction compresses them to roughly half.\l";
  "remain" [fillcolor="#e2e2e2", penwidth=2, fontsize=14];
  "shut" [fillcolor="#e2e2e2", penwidth=2, fontsize=14];
  "fled" [fillcolor="#e2e2e2", penwidth=2, fontsize=14];
  "follow" -> "remain" [label="3x"];
  "use" -> "remain" [label="3x"];
  "die" -> "remain" [label="3x"];
  "live" -> "remain" [label="2x"];
  "proceeded" -> "shut" [label="2x"];
  "made" -> "shut" [label="2x"];
  "helped" -> "shut" [label="2x"];
  "laid" -> "shut" [label="2x"];
  "has" -> "fled" [label="2x"];
  "painted" -> "fled" [label="1x"];
  "used" -> "fled" [label="1x"];
  "destroyed" -> "fled" [label="1x"];
  "go" -> "proceeded" [label="6x"];
  "leave" -> "proceeded" [label="5x"];
  "have" -> "follow" [label="3x"];
}
