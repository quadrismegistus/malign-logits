// The model-information pipeline. Measured 2026-08-15, redrawn after a night's work.
//
// v1 drew the BUILD side and concluded the shape was fine. It was -- and it missed
// the thing that actually bites. RH asked two seats the same question, "how do you
// get the representative model pairs", and got two different routes. THAT is the
// query side, and it is what this version centres.
//
//   dot -Tsvg docs/model-info-pipeline.dot -o docs/model-info-pipeline.svg
//
// GREEN  = repaired tonight, with the number
// RED    = still wrong
// ORANGE = a place a fact is decided (three; there should be one)
// PURPLE = ONE QUESTION, THREE ANSWERS -- the chaos, and the reason for the work

digraph model_info {
  rankdir=TB; compound=true;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, nodesep=0.3, ranksep=0.5,
         label="Model information: three declarations, one join, THREE ANSWERS\nmeasured 2026-08-15, after the night's repairs"];
  node [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded", fillcolor="#eef3f8", color="#7a8fa6"];
  edge [fontname="Helvetica", fontsize=9, color="#5a6b7d"];

  subgraph cluster_decl {
    label="DECLARED — three sites, should be one"; style="rounded,filled";
    fillcolor="#fff6e8"; color="#d9a441"; fontsize=11;
    MF   [label="MODEL_FAMILIES\n__init__.py · 64 families\nSLOT-BASED: one model per position", fillcolor="#ffe0b0", color="#c8860a"];
    XTRA [label="registry_extra_models.json\n8 models, now carrying position\nexists because the slots are FULL", fillcolor="#ffe0b0", color="#c8860a"];
    RMV  [label="REMOVED_POSITION\nIN CODE · 6 models", fillcolor="#ffe0b0", color="#c8860a"];
  }

  subgraph cluster_meas {
    label="MEASURED"; style="rounded,filled"; fillcolor="#eef7ee"; color="#6a9a6a"; fontsize=11;
    TOK [label="tokenizer_properties.json\n154 models  (+4 tonight)", fillcolor="#d6ecd6", color="#4a8a4a"];
    CJK [label="cjk_coverage.csv · 108"];
    PRB [label="probe fields · 306"];
  }

  BUILD [label="build_model_registry.py\nTHREE construction paths\nthe tokenizer join is now on ALL THREE",
         style=filled, fillcolor="#d6ecd6", color="#4a8a4a", penwidth=2];

  REG [label="model_registry.json · 159 rows\nposition   159/159   was 145\nvocab_len  154/159   was 0\ndirection    0/159   RULED, NOT BUILT\nstatus STILL ONE COLUMN holding three axes",
       fillcolor="#dce9f7", color="#3b6ea5", penwidth=2];

  subgraph cluster_q {
    label="ONE QUESTION — \"the representative model pairs\" — THREE ANSWERS";
    style="rounded,filled"; fillcolor="#f6eefb"; color="#8e5ea8"; fontsize=11;
    Q1 [label="lineage.representative_pairs()\n51 · live registry, measurable", fillcolor="#e9d9f2", color="#8e5ea8"];
    Q2 [label="movement_edges WHERE\nis_model_pair AND is_representative\n52 over 47 bases\nSTALE: built 12 Aug, before tonight", fillcolor="#e9d9f2", color="#8e5ea8"];
    Q3 [label="lineage_representative_pairs.txt\n46 · FROZEN to the battery\nholds 1 pair that is base>EGO", fillcolor="#e9d9f2", color="#8e5ea8"];
  }
  CHAOS [label="ALL THREE ARE CORRECT.\nNone announces which population it is.\nTwo seats asked the same question\ntook two different routes.\nTHE DEFECT IS THE AMBIGUITY,\nNOT THE NUMBERS.",
         shape=note, fillcolor="#f0e0f8", color="#8e5ea8", penwidth=2];

  subgraph cluster_acc {
    label="ACCESS"; style="rounded,filled"; fillcolor="#eef7ee"; color="#6a9a6a"; fontsize=11;
    CP [label="Checkpoint — THE FACADE\n28 files  (was 25)\nhas_data 152 · landed_v3 95 · is_excluded 6\nall three predicates repaired tonight", fillcolor="#d6ecd6", color="#4a8a4a", penwidth=2];
  }
  RAW [label="16 files still read the JSON raw\n9 builders — legitimate\n7 CONSUMERS LEFT  (was 18)\nlineage.py migrated: the library no\nlonger bypasses its own store",
       fillcolor="#ffe9e9", color="#c0392b", penwidth=2];

  SURF [label="surface conformance\nper (model, STORE) · one producer now\nRECOMPUTE, do not carry", fillcolor="#e8e8e8", color="#888888", style="filled,rounded,dashed"];

  MF -> BUILD; XTRA -> BUILD; RMV -> BUILD;
  TOK -> BUILD [label="joined on all 3 paths", color="#4a8a4a", fontcolor="#4a8a4a"];
  CJK -> BUILD; PRB -> BUILD;
  BUILD -> REG;
  REG -> Q1;
  REG -> Q2 [style=dashed, label="via a 12 Aug build"];
  REG -> Q3 [style=dashed, label="via the battery"];
  REG -> CP;
  REG -> RAW [color="#c0392b", penwidth=2, label="7 consumers left"];
  SURF -> CP [style=dotted, color="#888888", label="deliberately NOT wired"];

  N [shape=note, fillcolor="#fff0f0", color="#c0392b",
     label="STILL OPEN\n· direction: 0 rows, needs RH on spend\n· status: one column, three axes\n· 7 consumers\n· 3 declaration sites"];
  REG -> N [style=invis];
  Q2 -> CHAOS [style=invis];
  { rank=same; CHAOS; N; }
}
